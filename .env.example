# Sophia API Configuration

# Authentication token (REQUIRED)
# This token is validated against incoming Authorization: Bearer headers.
# All clients (Apollo, Hermes) must send this same token.
# For development: use "sophia_dev"
# For production: generate a secure random token
SOPHIA_API_TOKEN=sophia_dev

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jtest

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=*

# HCG Data Seeding (for prototype)
# Auto-seed pick-and-place scenario data on startup
SEED_PICK_AND_PLACE_DATA=true
# Clear existing HCG data before seeding (use with caution!)
CLEAR_BEFORE_SEED=false

# Logging Configuration (optional)
LOG_LEVEL=INFO
